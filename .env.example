# ── Frontend (safe for browser, exposed via Vite) ─────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-side secrets (scripts + Edge Functions) ────────────────────────────
# Supabase service role key — bypasses RLS, required for import scripts
SUPABASE_SERVICE_ROLE_KEY=

# ── Airtable integration ──────────────────────────────────────────────────────
# Personal access token from https://airtable.com/create/tokens
AIRTABLE_TOKEN=
# Base ID (starts with "app…") from your Airtable workspace URL
AIRTABLE_BASE=

# ── Edge Function secrets (set in Supabase Dashboard > Edge Functions > Secrets)
# OPENAI_API_KEY
# AI_GATEWAY_API_KEY
